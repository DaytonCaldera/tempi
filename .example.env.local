# Server-only secrets. Never prefix these with NEXT_PUBLIC_: Next.js inlines NEXT_PUBLIC_ variables
# into the JavaScript sent to every browser.
NEXTAUTH_SECRET=
# Production outside Vercel: the app's public URL, or Auth.js answers every request with UntrustedHost.
# (AUTH_TRUST_HOST=true instead trusts the Host header: only behind a proxy that sets it.) Not needed in `next dev`.
AUTH_URL=
GOOGLE_ID_CLIENT=
GOOGLE_API_SECRET=
MONGODB_URI=
# Optional: database to use instead of the one named in MONGODB_URI (e.g. tempi-development)
MONGODB_DB=
# Email of the only superadmin account. Without it nobody is superadmin.
SUPERADMIN_EMAIL=

# Optional: email through Resend (lib/email.ts): sign-in links and low stock alerts. Without both, email sign-in
# is hidden and alerts aren't sent.
AUTH_RESEND_KEY=
EMAIL_FROM=
# "true" to send low stock alerts in `next dev` too. Off by default: there they are only logged, so testing
# stock moves against a database with real admins doesn't email them.
SEND_ALERT_EMAILS=

# Optional: online payments with Lemon Squeezy (lib/billing.ts). Without the key and store, plans are only
# changed by the superadmin. Webhook URL: https://<domain>/api/billing/webhook, signing secret below.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# "true" while testing with the store in test mode
LEMONSQUEEZY_TEST_MODE=
# Variants of the catalog plans, copied into the plans by scripts/seed-plans.js
LEMONSQUEEZY_PRO_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_PRO_YEARLY_VARIANT_ID=
LEMONSQUEEZY_BUSINESS_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_BUSINESS_YEARLY_VARIANT_ID=
# Generic subscription variants custom plans are sold through, with their own price (custom_price). One per
# interval: a variant charges on its own interval. LEMONSQUEEZY_CUSTOM_VARIANT_ID still works as the monthly one
LEMONSQUEEZY_CUSTOM_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_CUSTOM_YEARLY_VARIANT_ID=
# Secret of the daily cron that applies yearly-to-monthly downgrades (GET /api/billing/scheduled-changes with
# Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Public: shown on the privacy policy and terms pages
NEXT_PUBLIC_CONTACT_EMAIL=
